# Copy to /etc/xdrop/env (or .env for local runs) and fill in.
# Random signing key for session cookies: python -c "import secrets; print(secrets.token_hex(32))"
XDROP_SECRET=change-me
# Owner password hash (scrypt), see README "Set the password".
XDROP_PASSWORD_HASH=
# SQLite database file.
XDROP_DB=/var/lib/xdrop/xdrop.db
# Where uploaded files live. Must contain an empty `.xdrop-storage` marker file.
XDROP_STORAGE=/srv/xdrop
# Free space (GB) always kept on the storage; uploads that would cut into it are refused.
XDROP_RESERVE_GB=5
# Unfinished uploads older than this are deleted.
XDROP_STALE_HOURS=48
# 1 = no login, every visitor is the owner. Only for private networks.
XDROP_OPEN=0
