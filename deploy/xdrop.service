[Unit]
Description=xdrop file sharing app
After=network-online.target
Wants=network-online.target

[Service]
User=xdrop
Group=xdrop
EnvironmentFile=/etc/xdrop/env
WorkingDirectory=/opt/xdrop
ExecStart=/opt/xdrop/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1 --timeout-keep-alive 75
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/xdrop /srv/xdrop
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
